# Enable only in builds that include the matching Firebase project config files.
EXPO_PUBLIC_FIREBASE_ANALYTICS_ENABLED=false

# Public runtime identifier for the Sentry project. This is not an auth token.
EXPO_PUBLIC_SENTRY_DSN=

# Local paths to Firebase client config files. Keep the files out of git.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist
